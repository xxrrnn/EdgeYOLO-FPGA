# ==============================================================================
# EdgeYOLO-FPGA source whitelist
# ==============================================================================
# The repo generates many large files. Keep source files visible, keep generated
# artifacts local unless they are explicitly force-added for a milestone.

*
!*/

# Root project files
!.gitignore
!.gitattributes
!Makefile
!makefile
!README.md
!README*
!*.md
!*.py
!*.sh
!*.tcl
!*.f
!*.data
!*.gtkw
!requirements*.txt

# Organized acceptance tests and cross-branch utilities
!TEST/
!TEST/**/
!TEST/**/*.py
!TEST/**/*.md
!TEST/**/*.txt
!TEST/**/*.json
!TEST/**/*.yaml
!TEST/**/*.yml
!TEST/**/*.jpg
!TEST/**/*.JPEG
!TEST/**/*.npz
!TEST/utils/bin/*.exe

# Final project documents (render intermediates remain under ignored tmp/).
!docs/**/*.docx
docs/~$*.docx

# Source trees
!rtl/
!rtl/**/
!rtl/**/*.v
!rtl/**/*.sv
!rtl/**/*.vh
!rtl/**/*.vhd
!rtl/**/*.cpp
!rtl/**/*.h
!rtl/**/.gitignore

!scripts/
!scripts/**/
!scripts/**/*.tcl
!scripts/**/*.sh
!scripts/**/*.py

!tools/
!tools/**/
!tools/**/*.py
!tools/**/*.sh
!tools/**/*.tcl
!tools/Makefile

!xdc/
!xdc/**/
!xdc/**/*.xdc

# ==============================================================================
# Generated Vivado/build artifacts
# ==============================================================================
build/**
logs/**
.Xil/
*.jou
*.log
*.str
*.xpr
*.dcp
*.rpt
*.pb
*.bit
*.bin
*.ltx
*.mcs
*.prm
*.mmi
*.cache/
*.gen/
*.hw/
*.ip_user_files/
*.sim/
*.srcs/
*.runs/
/bd/
rtl/chip/build/
scripts/chip-lite/tmp/
sim/lite_bd_export/**

# ==============================================================================
# Runtime outputs and temporary probes
# ==============================================================================
output/**

# Downloaded model packages and external algorithm repos
weihgts/
weights/
model/**/*.onnx
model/**/*.pt
model/**/*.pth
model/**/*.pkl
model/**/*.pb
model/**/*.tar.gz
model/**/*.onnx.bak
model/algorithm/Infrared-Object-Detection/
model/algorithm/Resnet18-quantization/
model/algorithm/quantized-yolov5/
model/algorithm/quantized-yolov5_arcive/

# Files moved into TEST/end2end and TEST/utils.  Keep the explicit binary
# allow-list narrow so generated artifacts under TEST remain ignored.
!TEST/utils/bitstream/*.bit
!TEST/end2end/yolo/model/int8/*.pt
!TEST/end2end/yolo/model/int8/*.onnx
!TEST/end2end/yolo/model/int16/*.pt
!TEST/end2end/yolo/model/int16/*.onnx
!TEST/end2end/resnet/model/*.onnx

# ==============================================================================
# Simulation and tool byproducts
# ==============================================================================
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/
.codex/
.codex_tmp/
.pytest_cache/
/tmp/
.cursor/

rtl/ref/YOLOv11-RTL/
rtl/**/spyglass/
rtl/**/.project*
rtl/**/.design*
rtl/**/.CurrentSessionRunSummaryFiles
rtl/**/xsim.dir/
rtl/**/sim/build_*/
rtl/tb/lite_bd/module_tb/sim/compile/
rtl/**/simv*
rtl/**/simv*.daidir/
rtl/**/csrc/
rtl/**/verdiLog/
rtl/**/vfastLog/
rtl/**/ucli.key
rtl/**/novas*.log
rtl/**/*.fsdb
rtl/**/*.wdb
rtl/**/xelab.*
rtl/**/xvlog.*
rtl/**/xsim*.jou
rtl/**/xsim*.log
rtl/**/xsim*.pb

.cxl.vcs*.version
synopsys_sim.setup
