# ==============================================================================
# EdgeYOLO-FPGA source whitelist
# ==============================================================================
# The repo generates many large files. Keep source files visible, keep generated
# artifacts local unless they are explicitly force-added for a milestone.

*
!*/

# Root project files
!.gitignore
!.gitattributes
!Makefile
!makefile
!README.md
!README*
!*.md
!*.py
!*.sh
!*.tcl
!*.f
!*.ipynb
!*.data
!*.gtkw
!requirements*.txt

# Source trees
!rtl/
!rtl/**/
!rtl/**/*.v
!rtl/**/*.sv
!rtl/**/*.vh
!rtl/**/*.vhd
!rtl/**/*.cpp
!rtl/**/*.h
!rtl/**/.gitignore

!scripts/
!scripts/**/
!scripts/**/*.tcl
!scripts/**/*.sh
!scripts/**/*.py

!tools/
!tools/**/
!tools/**/*.py
!tools/**/*.sh
!tools/**/*.tcl
!tools/Makefile

!tests/
!tests/**/
!tests/**/*.py
!tests/**/*.ipynb
!tests/**/*.sh
!tests/**/*.yaml
!tests/**/*.yml

!xdc/
!xdc/**/
!xdc/**/*.xdc

# Model metadata and checked-in parsed weights used by current flows.
!model/
!model/**/
!model/**/*.md
!model/**/*.json
!model/**/*.yaml
!model/**/*.yml
!model/yolov5n/parsed/weights/*.npz
!model/yolov5n/parsed_int16_widened/weights/*.npz
!model/resnet18/parsed_vai/weights/*.npz
!model/resnet18/parsed_vai_int16_widened/weights/*.npz

# Keep small top-level sample images if they already exist.
!test_yolo.jpg
!test_resnet*.jpg
!test_resnet*.JPEG

# ==============================================================================
