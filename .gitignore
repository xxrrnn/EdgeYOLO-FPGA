# ==============================================================================
build/**
logs/**
.Xil/
*.jou
*.log
*.str
*.xpr
*.dcp
*.rpt
*.pb
*.bit
*.bin
*.ltx
*.mcs
*.prm
*.mmi
*.cache/
*.gen/
*.hw/
*.ip_user_files/
*.sim/
*.srcs/
*.runs/
bd/
rtl/chip/build/
scripts/chip-lite/tmp/

# ==============================================================================
# Runtime outputs and temporary probes
# ==============================================================================
output/**
!output/
!output/final_inference/
!output/final_inference/README.md
!output/probe/
!output/probe/README.md

# Downloaded model packages and external algorithm repos
weihgts/
weights/
model/**/*.onnx
model/**/*.pt
model/**/*.pth
model/**/*.pkl
model/**/*.pb
model/**/*.tar.gz
model/**/*.onnx.bak
model/algorithm/Infrared-Object-Detection/
model/algorithm/Resnet18-quantization/
model/algorithm/quantized-yolov5/
model/algorithm/quantized-yolov5_arcive/

# Self-contained c1773f6 inference milestone. These exceptions intentionally
# come after the generic bitstream, output, and weights exclusions above.
!chip.bit
!artifacts/
!artifacts/c1773f6/
!artifacts/c1773f6/**
# Local copy byproducts are not part of the frozen reference layout.
artifacts/c1773f6/reference_results/*/one_shot_*/
!model/yolov5n_coco50k_qat/
!model/yolov5n_coco50k_qat/**/
!model/yolov5n_coco50k_qat/README.txt
!model/yolov5n_coco50k_qat/parse_quant_export.py
!model/yolov5n_coco50k_qat/parsed_int8/network.json
!model/yolov5n_coco50k_qat/parsed_int8/activation_scales.json
!model/yolov5n_coco50k_qat/parsed_int8/weights/*.npz
!model/yolov5n_coco50k_qat/parsed_int16_widened/network.json
!model/yolov5n_coco50k_qat/parsed_int16_widened/activation_scales.json
!model/yolov5n_coco50k_qat/parsed_int16_widened/weights/*.npz
!model/yolov5n_coco50k_qat/template/*.jpg

