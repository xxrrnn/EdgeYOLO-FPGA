# ==============================================================================
# EdgeYOLO-FPGA source whitelist
# ==============================================================================
# The repo generates many large files. Keep source files visible, keep generated
# artifacts local unless they are explicitly force-added for a milestone.

*
!*/

# Root project files
!.gitignore
!.gitattributes
!Makefile
!makefile
!README.md
!README*
!*.md
!*.py
!*.sh
!*.tcl
!*.f
!*.data
!*.gtkw
!requirements*.txt

# Final project documents (render intermediates remain under ignored tmp/).
!docs/**/*.docx

# Source trees
!rtl/
!rtl/**/
!rtl/**/*.v
!rtl/**/*.sv
!rtl/**/*.vh
!rtl/**/*.vhd
!rtl/**/*.cpp
!rtl/**/*.h
!rtl/**/.gitignore

!scripts/
!scripts/**/
!scripts/**/*.tcl
!scripts/**/*.sh
!scripts/**/*.py

!tools/
!tools/**/
!tools/**/*.py
!tools/**/*.sh
!tools/**/*.tcl
!tools/Makefile

!tests/
!tests/**/
!tests/**/*.py
!tests/**/*.sh
!tests/**/*.yaml
!tests/**/*.yml
!tests/bin/*.exe

!xdc/
!xdc/**/
!xdc/**/*.xdc

# Model metadata and checked-in parsed weights used by current flows.
!model/
!model/**/
!model/**/*.md
!model/**/*.json
!model/**/*.yaml
!model/**/*.yml
!model/model_inputs_manifest.json
!model/resnet18/parsed_vai/weights/*.npz
!model/resnet18/parsed_vai_int16_widened/weights/*.npz

!examples/
!examples/**/
!examples/**/*.md
!examples/**/*.json
!examples/**/*.jpg
!examples/**/*.JPEG

