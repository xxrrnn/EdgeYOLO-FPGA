# Keep source scripts portable across Windows, WSL, and Linux build servers.
* text=auto

Makefile text eol=lf
*.tcl text eol=lf
*.sh text eol=lf
*.xdc text eol=lf
*.sv text eol=lf
*.v text eol=lf
*.vh text eol=lf
*.py text eol=lf
*.md text eol=lf

*.bit binary
*.bin binary
bitstream/*.rpt binary
*.dcp binary
*.ltx binary
*.wdb binary
*.onnx binary
*.pt binary
*.npz binary
*.npy binary
*.jpg binary
*.JPEG binary
*.docx binary
*.exe binary
*.jou text eol=lf
*.log text eol=lf
